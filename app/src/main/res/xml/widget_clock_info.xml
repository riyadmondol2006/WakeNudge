<?xml version="1.0" encoding="utf-8"?>
<!--
    Attributes from Android 12 (targetCell*, previewLayout, maxResize*) are ignored by older launchers; the min* sizes cover them.
    updatePeriodMillis is 0 on purpose: a periodic update wakes the device (and starts this app) every 30 minutes for every
    placed widget. Redraws are event-driven instead, see SurfaceRefresherImpl and SurfaceRollover.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:description="@string/widget_clock_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_preview_clock"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
