<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup; on-device transfer to a new phone is allowed. Local backup/restore is in the app. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="device_file" path="." />
        <include domain="device_database" path="." />
        <include domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
