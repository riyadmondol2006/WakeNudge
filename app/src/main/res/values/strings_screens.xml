    <!-- About -->
    <string name="about_name">WakeNudge</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_tagline">A free, open-source alarm clock that gets you out of bed — and keeps your data to itself.</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_offline">Works completely offline</string>
    <string name="about_offline_body">WakeNudge does not have the internet permission. It cannot send anything anywhere.</string>
    <string name="about_no_tracking">No ads, accounts or tracking</string>
    <string name="about_no_tracking_body">There is nothing to sign up for and nothing to pay. Your alarms and history stay on this phone.</string>
    <string name="about_permissions">Permissions only when needed</string>
    <string name="about_permissions_body">Camera, activity recognition, NFC and calendar are requested only when you use a feature that needs them.</string>
    <string name="about_license">License</string>
    <string name="about_license_name">Apache License 2.0</string>
    <string name="about_license_body">You are free to use, study, change and share this app. The source code is public.</string>
    <string name="about_libraries">Open-source libraries</string>

    <!-- Onboarding -->
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_start">Get started</string>
    <string name="onboarding_welcome_title">Wake up on purpose</string>
    <string name="onboarding_welcome_body">WakeNudge is an alarm clock that makes sure you actually get up, with a calm design that stays out of the way.</string>
    <string name="onboarding_reliable_title">Rings when it must</string>
    <string name="onboarding_reliable_body">Lock screen, silent mode, battery saver or a restart in the night: the alarm is scheduled the way the system intends, and re-armed after a reboot.</string>
    <string name="onboarding_missions_title">Missions, not mashing</string>
    <string name="onboarding_missions_body">Solve a sum, scan a barcode, shake, walk or squat before the alarm lets go. Add a backup alarm and a “still awake?” check, and switch any of it off whenever you like.</string>
    <string name="onboarding_privacy_title">Private by design</string>
    <string name="onboarding_privacy_body">No internet permission, no ads, no accounts, no tracking. Everything stays on your phone.</string>
    <string name="onboarding_permissions_title">One last thing</string>
    <string name="onboarding_permissions_body">These make sure your alarm can wake you. You can change them later in Alarm health.</string>
    <string name="onboarding_perm_notifications">Notifications</string>
    <string name="onboarding_perm_notifications_body">Needed to show the alarm and its Snooze and Dismiss buttons.</string>
    <string name="onboarding_perm_fullscreen">Full-screen alarm</string>
    <string name="onboarding_perm_fullscreen_body">Lets the alarm light up the screen over the lock screen.</string>
    <string name="onboarding_perm_battery">Battery</string>
    <string name="onboarding_perm_battery_body">Optional: if your phone is aggressive about battery saving, allow WakeNudge to run unrestricted.</string>
    <string name="onboarding_allow">Allow</string>
    <string name="onboarding_granted">Granted</string>
    <string name="onboarding_open_settings">Open settings</string>

