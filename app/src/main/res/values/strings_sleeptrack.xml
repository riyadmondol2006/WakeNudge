<?xml version="1.0" encoding="utf-8"?>
<!-- Sleep tracking: the Track my sleep screen, the night detail, the Sleep part of the Report and the tracking notification. -->
<resources>
    <!-- Track my sleep screen -->
    <string name="sleeptrack_ready_title">Ready for bed</string>
    <string name="sleeptrack_ready_body">Put your phone on the mattress near your pillow, then tap Start. Tap I\'m up in the morning, or dismiss your alarm: tracking stops by itself.</string>
    <string name="sleeptrack_start">Start</string>
    <string name="sleeptrack_im_up">I\'m up</string>
    <string name="sleeptrack_no_sensor">This phone has no motion sensor that sleep tracking can use.</string>
    <string name="sleeptrack_battery_hint">Your phone isn\'t charging. A whole night of tracking uses some battery, so plug it in if you can.</string>
    <string name="sleeptrack_snoring">Record snoring</string>
    <string name="sleeptrack_snoring_note">Listens on this phone only, keeps at most 3 short clips a night for 7 days, and stops when an alarm rings.</string>
    <string name="sleeptrack_delete_all_clips">Delete all snore clips</string>
    <plurals name="sleeptrack_clip_count">
        <item quantity="one">%d clip kept</item>
        <item quantity="other">%d clips kept</item>
    </plurals>
    <string name="sleeptrack_delete_all_clips_title">Delete all snore clips?</string>
    <string name="sleeptrack_delete_all_clips_body">Every recorded clip is removed from this phone. Your nights stay.</string>
    <string name="sleeptrack_delete">Delete</string>
    <string name="sleeptrack_last_night">Last night</string>
    <string name="sleeptrack_view_night">View night</string>
    <string name="sleeptrack_how_title">How this works</string>
    <string name="sleeptrack_how_body">Stages are estimated from how much you move (and from sound, if Record snoring is on). They are a rough guide, not a measurement like a sleep lab makes, and not medical advice. Results are best with the phone on the mattress, not on a nightstand.</string>
    <string name="sleeptrack_how_short">Estimated from movement and sound, not measured like a sleep lab. Best with the phone on the mattress.</string>

    <!-- While tracking -->
    <string name="sleeptrack_tracking_for">Tracking for %1$s</string>
    <string name="sleeptrack_mic_on">Microphone on, listening for snoring</string>
    <string name="sleeptrack_mic_off">Movement only, microphone off</string>
    <string name="sleeptrack_mic_stopped">Microphone off: an alarm rang</string>
    <string name="sleeptrack_leave_hint">You can turn the screen off or leave this screen. Tracking keeps going.</string>

    <!-- Permissions and problems -->
    <string name="sleeptrack_need_activity_title">Allow physical activity</string>
    <string name="sleeptrack_need_activity_body">On this version of Android, tracking movement while the screen is off needs the physical activity permission. It is only used to feel how you move in bed, on this phone.</string>
    <string name="sleeptrack_open_settings">Open settings</string>
    <string name="sleeptrack_cancel">Cancel</string>
    <string name="sleeptrack_mic_denied">Record snoring stays off: the microphone isn\'t allowed.</string>
    <string name="sleeptrack_refused">Android didn\'t let sleep tracking start. Open the app and tap Start again; if it keeps happening, check that WakeNudge may run in the background.</string>
    <string name="sleeptrack_mic_unavailable">The microphone couldn\'t be used, so tonight is tracked by movement only.</string>
    <string name="sleeptrack_time_limit">Tracking stopped after 16 hours.</string>

