<?xml version="1.0" encoding="utf-8"?>
<!-- Static sample shown in the widget picker (Android 12+); the clock itself is live. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/widget_clock_text"
        android:textSize="56sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="@string/widget_preview_date"
        android:textColor="@color/widget_clock_text_variant"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:singleLine="true"
        android:text="@string/widget_line_time_day_preview"
        android:textColor="@color/widget_clock_text"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
